{
  "name": "sdxl-controlnet",
  "description": "SDXL + pixel-art LoRA guided by the edges of a sketch or a composed scene (ControlNet canny): keeps the layout and camera, paints anew",
  "defaults": {
    "ckpt": "sd_xl_base_1.0.safetensors",
    "lora": "pixel-art-xl.safetensors",
    "lora_strength": 0.7,
    "controlnet": "controlnet-canny-sdxl-1.0.safetensors",
    "control_strength": 0.9,
    "control_end": 0.8,
    "steps": 30,
    "cfg": 6.0,
    "clip_strength": 0.7
  },
  "modes": {
    "img2img": {
      "workflow": {
        "4": {
          "class_type": "CheckpointLoaderSimple",
          "inputs": {
            "ckpt_name": ""
          }
        },
        "10": {
          "class_type": "LoraLoader",
          "inputs": {
            "model": [
              "4",
              0
            ],
            "clip": [
              "4",
              1
            ],
            "lora_name": "",
            "strength_model": 0.8,
            "strength_clip": 0.8
          }
        },
        "6": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "",
            "clip": [
              "10",
              1
            ]
          }
        },
        "7": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "",
            "clip": [
              "10",
              1
            ]
          }
        },
        "11": {
          "class_type": "LoadImage",
          "inputs": {
            "image": ""
          }
        },
        "13": {
          "class_type": "Canny",
          "inputs": {
            "image": [
              "11",
              0
            ],
            "low_threshold": 0.2,
            "high_threshold": 0.5
          }
        },
        "14": {
          "class_type": "ControlNetLoader",
          "inputs": {
            "control_net_name": ""
          }
        },
        "15": {
          "class_type": "ControlNetApplyAdvanced",
          "inputs": {
            "positive": [
              "6",
              0
            ],
            "negative": [
              "7",
              0
            ],
            "control_net": [
              "14",
              0
            ],
            "image": [
              "13",
              0
            ],
            "strength": 0.7,
            "start_percent": 0.0,
            "end_percent": 0.8
          }
        },
        "5": {
          "class_type": "EmptyLatentImage",
          "inputs": {
            "width": 1024,
            "height": 576,
            "batch_size": 1
          }
        },
        "3": {
          "class_type": "KSampler",
          "inputs": {
            "seed": 0,
            "steps": 30,
            "cfg": 6.0,
            "sampler_name": "dpmpp_2m",
            "scheduler": "karras",
            "denoise": 1.0,
            "model": [
              "10",
              0
            ],
            "positive": [
              "15",
              0
            ],
            "negative": [
              "15",
              1
            ],
            "latent_image": [
              "5",
              0
            ]
          }
        },
        "8": {
          "class_type": "VAEDecode",
          "inputs": {
            "samples": [
              "3",
              0
            ],
            "vae": [
              "4",
              2
            ]
          }
        },
        "9": {
          "class_type": "SaveImage",
          "inputs": {
            "filename_prefix": "pixelwright",
            "images": [
              "8",
              0
            ]
          }
        }
      },
      "inputs": {
        "prompt": [
          "6",
          "text"
        ],
        "negative": [
          "7",
          "text"
        ],
        "seed": [
          "3",
          "seed"
        ],
        "steps": [
          "3",
          "steps"
        ],
        "cfg": [
          "3",
          "cfg"
        ],
        "ckpt": [
          "4",
          "ckpt_name"
        ],
        "lora": [
          "10",
          "lora_name"
        ],
        "lora_strength": [
          "10",
          "strength_model"
        ],
        "init_image": [
          "11",
          "image"
        ],
        "controlnet": [
          "14",
          "control_net_name"
        ],
        "control_strength": [
          "15",
          "strength"
        ],
        "control_end": [
          "15",
          "end_percent"
        ],
        "width": [
          "5",
          "width"
        ],
        "height": [
          "5",
          "height"
        ],
        "batch": [
          "5",
          "batch_size"
        ],
        "clip_strength": [
          "10",
          "strength_clip"
        ]
      }
    }
  },
  "min_side": 768
}
